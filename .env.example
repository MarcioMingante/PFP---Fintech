POSTGRES_DB=fintrack
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
API_PORT=5168
WEB_PORT=3000

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=
# Local HTTP only; set true when serving frontend over HTTPS.
AUTH_COOKIE_SECURE=false

REDIS_PORT=6379
DASHBOARD_CACHE_TTL_SECONDS=60

BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOBS_INTERVAL_SECONDS=60

# RabbitMQ: use uma senha local própria, alfanumérica (URI AMQP).
MESSAGING_ENABLED=true
RABBITMQ_USER=fintrack
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

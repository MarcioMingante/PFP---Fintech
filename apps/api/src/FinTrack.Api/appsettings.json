{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DashboardCache": {
    "Enabled": false,
    "TtlSeconds": 60
  },
  "BackgroundJobs": {
    "Enabled": false,
    "IntervalSeconds": 60,
    "MaxAttempts": 3,
    "RetryDelayMilliseconds": 500,
    "MaxUsersPerCycle": 100
  },
  "Messaging": {
    "Enabled": false
  }
}
